# Lokalni šablon. Compose ne učitava ovaj fajl.
# Na svakom računaru kopirati ga u .env.testing i generisati sopstveni ključ:
#   cp .env.testing.docker.example .env.testing
#   php artisan key:generate --env=testing
# .env.testing je u .gitignore. APP_KEY ostaje prazan u ovom šablonu.
# Ova baza je prazan lokalni MySQL u Dockeru. Nema veze sa Pleskom,
# opstinakotor_digital ni opstinakotor_dev. Ne unositi produkcione podatke.

APP_NAME="Digital Kotor"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Belgrade

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=digital_kotor_testing
DB_USERNAME=testing
DB_PASSWORD=testing

CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
